# ClearSign Environment Variables Template
# Copy to .env.local for local development. Never commit real keys.

# LLM Provider Configuration (Groq)
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# Optional vision model for photo transcription
LLM_MODEL_VISION=llama-3.2-11b-vision-preview

# Rate Limiting (Optional: in-memory fallback is used if Upstash is not configured)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS_PER_MINUTE=10
