# ClearSign Environment Variables Template
# Copy to .env.local for local development. Never commit real keys.

# LLM Provider Configuration (e.g. "gemini")
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Optional strong model for complex analysis fallback
LLM_MODEL_STRONG=gemini-2.5-pro

# Rate Limiting (Optional: in-memory fallback is used if Upstash is not configured)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS_PER_MINUTE=10
